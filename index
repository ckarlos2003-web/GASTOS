                name: 'DESAY MENU L-V',
                color: 'bg-amber-500/20 text-amber-300 border-amber-500/40',
                headerColor: 'bg-amber-400 text-slate-950',
                daysType: 'working', // L-V
                start: '2026-06-22',
                actual: '2026-07-11',
                end: '2026-07-22',
                income: 319.00,
                saldoTarjeta: 174.00
            },
            {
