                headerColor: 'bg-orange-500 text-slate-950',
                daysType: 'saturday', // Solo Sábados
                start: '2026-06-22',
                actual: '2026-07-11',
                end: '2026-07-22',
                income: 48.00,
                saldoTarjeta: 0.00
            }
        ];

        // Estado Global guardado localmente
        let state = {
            categories: JSON.parse(localStorage.getItem('premium_budget_state_aligned_v4')) || [...DEFAULT_CATEGORIES]
        };

        // Alertas visuales no bloqueantes
        function showNotification(message) {
            const notif = document.getElementById('custom-notification');
            const text = document.getElementById('notification-text');
            text.innerText = message;
            notif.classList.remove('translate-y-20', 'opacity-0');
            notif.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                notif.classList.remove('translate-y-0', 'opacity-100');
                notif.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }

        // Algoritmo para calcular los días del ciclo completo y los días restantes según el tipo de calendario
        function calculateDaysByMode(startDateStr, endDateStr, mode, isRemaining = false) {
            if (!startDateStr || !endDateStr) return 0;
            
            // Separación manual de strings para mitigar problemas de huso horario del navegador
            const startParts = startDateStr.split('-');
            const endParts = endDateStr.split('-');
            
            if (startParts.length !== 3 || endParts.length !== 3) return 0;
            
            let start = new Date(startParts[0], startParts[1] - 1, startParts[2]);
            let end = new Date(endParts[0], endParts[1] - 1, endParts[2]);
            
            if (isNaN(start.getTime()) || isNaN(end.getTime())) return 0;
            
            // Regla de Excel: La fecha de término es exclusiva en gastos (se calcula hasta end - 1 día)
            const targetEnd = new Date(end);
            targetEnd.setDate(targetEnd.getDate() - 1);
            
            let current = new Date(start);
            if (isRemaining) {
                // Para días restantes de amortización, se empieza a contar desde el día posterior a la fecha actual
                current.setDate(current.getDate() + 1);
            }
            
            let count = 0;
            while (current <= targetEnd) {
                const day = current.getDay(); // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
                if (mode === 'working') {
                    if (day !== 0 && day !== 6) {
                        count++;
                    }
                } else if (mode === 'saturday') {
                    if (day === 6) {
                        count++;
                    }
                } else {
                    count++;
                }
                current.setDate(current.getDate() + 1);
            }
            return count;
        }

        // Calcula los días calendario faltantes exactos (Fecha de Término - Fecha Actual)
        function calculateCalendarDaysRemaining(actualDateStr, endDateStr) {
            if (!actualDateStr || !endDateStr) return 0;
            const actualParts = actualDateStr.split('-');
            const endParts = endDateStr.split('-');
            if (actualParts.length !== 3 || endParts.length !== 3) return 0;
            
            let actual = new Date(actualParts[0], actualParts[1] - 1, actualParts[2]);
            let end = new Date(endParts[0], endParts[1] - 1, endParts[2]);
            
            if (isNaN(actual.getTime()) || isNaN(end.getTime())) return 0;
            
            const diffTime = end.getTime() - actual.getTime();
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return diffDays > 0 ? diffDays : 0;
        }

        // Formateador oficial de moneda: Soles Peruanos con 2 decimales
        function formatPEN(val) {
            if (isNaN(val) || val === null) return "S/ 0.00";
            const isNegative = val < 0;
            const absVal = Math.abs(val).toFixed(2);
            return `${isNegative ? '-' : ''}S/ ${absVal}`;
        }

        // Renderización completa del dashboard
        function renderDashboard() {
            const headerRow = document.getElementById('table-header-row');
            const tbody = document.getElementById('spreadsheet-body');
            
            // 1. Renderizar Headers de Columnas (Alineación perfecta asegurada)
            let headerHTML = `
                <th class="p-4 font-bold text-xs uppercase tracking-wider text-slate-400 w-1/5 min-w-[200px]">
                    INDICADOR / CUENTA
                </th>
            `;
            
            state.categories.forEach((cat, index) => {
                headerHTML += `
                    <th class="p-4 text-center font-bold relative group w-52 min-w-[180px]">
                        <div class="px-3 py-1.5 rounded-lg inline-flex items-center gap-2 ${cat.headerColor || 'bg-slate-800 text-white'} text-xs font-black shadow-md uppercase tracking-wider">
                            <span>${cat.name}</span>
                            <button onclick="removeCategory(${index})" class="text-slate-950/60 hover:text-slate-950 transition ml-1" title="Eliminar Columna">
                                <i class="fa-solid fa-circle-xmark"></i>
                            </button>
                        </div>
                    </th>
                `;
            });

            // Columna de Totales a la derecha
            headerHTML += `
                <th class="p-4 font-bold text-xs uppercase tracking-wider text-slate-200 bg-slate-900 w-44 text-center min-w-[160px]">
                    TOTALES
                </th>
            `;
            
            headerRow.innerHTML = headerHTML;

            // 2. Fórmulas y especificación de filas según el Excel de referencia
            const rowsConfig = [
                // Fila cuántos días ahora calcula días calendario (Fórmula: Término - Actual)
                { id: 'cuantos_dias', label: 'CUANTOS DIAS', icon: 'fa-hourglass-half', calc: (c) => calculateCalendarDaysRemaining(c.actual, c.end), isCalculated: true, labelClass: 'text-slate-400 font-semibold', hideTotal: true },
                { id: 'fecha_inicio', label: 'FECHA DE INICIO', icon: 'fa-calendar-plus', isDate: true, key: 'start', hideTotal: true },
                { id: 'fecha_actual', label: 'FECHA ACTUAL', icon: 'fa-calendar-day', isDate: true, key: 'actual', hideTotal: true },
                { id: 'fecha_termino', label: 'FECHA DE TERMINO', icon: 'fa-calendar-check', isDate: true, key: 'end', labelClass: 'text-rose-400 font-bold', hideTotal: true },
                { id: 'ingreso_gasto', label: 'INGRESO GASTO', icon: 'fa-money-bill-wave', isNumber: true, key: 'income', rowClass: 'bg-slate-900/30', labelClass: 'text-red-500 font-black' },
                { id: 'gasto_por_dia', label: 'GASTO POR DIA', icon: 'fa-calculator', calc: (c) => {
                    const totalPeriodDays = calculateDaysByMode(c.start, c.end, c.daysType, false);
                    return totalPeriodDays > 0 ? (c.income / totalPeriodDays) : 0;
                }, isCalculated: true, format: true },
                { id: 'resultado_saldo', label: 'RESULTADO SALDO', icon: 'fa-chart-pie', calc: (c) => {
                    const remainingDays = calculateDaysByMode(c.actual, c.end, c.daysType, true);
                    const totalPeriodDays = calculateDaysByMode(c.start, c.end, c.daysType, false);
                    const dailyRate = totalPeriodDays > 0 ? (c.income / totalPeriodDays) : 0;
                    return remainingDays * dailyRate;
                }, isCalculated: true, format: true, rowClass: 'bg-amber-500/10 border-amber-500/20', labelClass: 'text-amber-400 font-bold' },
                { id: 'saldo_tarjeta', label: 'SALDO TARJETA', icon: 'fa-credit-card', isNumber: true, key: 'saldoTarjeta', rowClass: 'glow-red-border border-2 bg-rose-950/20 my-2 rounded-xl transition-all duration-300', labelClass: 'text-rose-400 font-black tracking-wide' },
                { id: 'faltante', label: 'FALTANTE', icon: 'fa-circle-exclamation', calc: (c) => {
                    const remainingDays = calculateDaysByMode(c.actual, c.end, c.daysType, true);
                    const totalPeriodDays = calculateDaysByMode(c.start, c.end, c.daysType, false);
                    const dailyRate = totalPeriodDays > 0 ? (c.income / totalPeriodDays) : 0;
                    const resultBudget = remainingDays * dailyRate;
                    return resultBudget - c.saldoTarjeta;
                }, isCalculated: true, format: true, labelClass: 'text-slate-300 font-black' }
            ];

            tbody.innerHTML = '';

            // 3. Renderizado preciso fila por fila
            rowsConfig.forEach((rowSpec) => {
                let rowHTML = `<tr class="border-b border-slate-800/40 hover:bg-slate-900/20 transition-colors ${rowSpec.rowClass || ''}">`;
                
                // Etiqueta lateral izquierda
                rowHTML += `
                    <td class="p-4 font-semibold text-slate-300 flex items-center gap-2.5">
                        <i class="fa-solid ${rowSpec.icon} w-5 text-slate-500 text-center"></i>
                        <span class="${rowSpec.labelClass || ''}">${rowSpec.label}</span>
                    </td>
                `;

                let totalAcumulado = 0;

                // Renderizar columnas de categorías correspondientes
                state.categories.forEach((cat, cIdx) => {
                    if (rowSpec.isDate) {
                        rowHTML += `
                            <td class="p-3 text-center">
                                <div class="relative inline-block w-full max-w-[170px]">
                                    <input type="date" value="${cat[rowSpec.key]}" 
                                        onchange="updateValue(${cIdx}, '${rowSpec.key}', this.value)" 
                                        class="bg-slate-950 border border-slate-800 hover:border-slate-700 rounded-lg px-2.5 py-1.5 text-center text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500 w-full transition cursor-pointer">
                                </div>
                            </td>
                        `;
                    } else if (rowSpec.isNumber) {
                        const isTarjeta = rowSpec.key === 'saldoTarjeta';
                        const numericVal = parseFloat(cat[rowSpec.key] || 0).toFixed(2);
                        rowHTML += `
                            <td class="p-3 text-center">
                                <div class="relative inline-flex items-center w-full max-w-[150px] rounded-lg bg-slate-950 border ${isTarjeta ? 'border-rose-500 focus-within:ring-2 focus-within:ring-rose-500/30' : 'border-slate-800 focus-within:border-slate-700'}">
                                    <span class="pl-2.5 text-xs text-slate-500 font-bold select-none">S/</span>
                                    <input type="number" step="0.01" value="${numericVal}" 
                                        onchange="updateValue(${cIdx}, '${rowSpec.key}', parseFloat(this.value) || 0)" 
                                        onblur="this.value = parseFloat(this.value || 0).toFixed(2)"
                                        class="bg-transparent border-none text-right px-2.5 py-1.5 text-xs text-white font-black w-full focus:outline-none">
                                </div>
                            </td>
                        `;
                        totalAcumulado += parseFloat(cat[rowSpec.key]) || 0;
                    } else if (rowSpec.isCalculated) {
                        const calculatedVal = rowSpec.calc(cat);
                        totalAcumulado += calculatedVal;
                        
                        let cellContent = '';
                        if (rowSpec.format) {
                            if (rowSpec.id === 'faltante') {
                                // Lógica de colores del semáforo financiero para Faltante (Sobra/Verde si <= 0, Falta/Rojo si > 0)
                                const hasDeficit = calculatedVal > 0;
                                const glowClass = hasDeficit ? 'text-glow-red font-extrabold' : 'text-glow-green font-extrabold';
                                cellContent = `<span class="${glowClass}">${formatPEN(calculatedVal)}</span>`;
                            } else {
                                cellContent = `<span class="font-bold text-slate-200">${formatPEN(calculatedVal)}</span>`;
                            }
                        } else {
                            cellContent = `<span class="font-bold text-slate-300">${calculatedVal}</span>`;
                        }

                        rowHTML += `<td class="p-3 text-center">${cellContent}</td>`;
                    }
                });

                // Renderizar Columna de "TOTALES" a la derecha
                let totalDisplay = '';
                if (rowSpec.hideTotal) {
                    totalDisplay = '<span class="text-slate-600">-</span>';
                } else if (rowSpec.format || rowSpec.isNumber) {
                    if (rowSpec.id === 'faltante') {
                        const hasDeficit = totalAcumulado > 0;
                        const glowClass = hasDeficit ? 'text-glow-red font-black' : 'text-glow-green font-black';
                        totalDisplay = `<span class="${glowClass}">${formatPEN(totalAcumulado)}</span>`;
                    } else {
                        totalDisplay = `<span class="font-black text-white">${formatPEN(totalAcumulado)}</span>`;
                    }
                } else {
                    totalDisplay = `<span class="font-bold text-slate-300">${totalAcumulado}</span>`;
                }

                rowHTML += `
                    <td class="p-4 text-center bg-slate-950/50 font-black border-l border-slate-800">
                        ${totalDisplay}
                    </td>
                `;

                rowHTML += `</tr>`;
                tbody.innerHTML += rowHTML;
            });

            // Persistir cambios locales en navegador
            localStorage.setItem('premium_budget_state_aligned_v4', JSON.stringify(state.categories));
            
            // Actualizar asesor y métricas superiores
            updateAdvisorMetrics();
        }

        // Actualiza el motor de Inteligencia Artificial Local y Métricas del Header
        function updateAdvisorMetrics() {
            let totalIncome = 0;
            let totalCard = 0;
            let totalDeficit = 0;
            let categoriesWithDeficit = [];

            state.categories.forEach(cat => {
                totalIncome += cat.income;
                totalCard += cat.saldoTarjeta;

                const remainingDays = calculateDaysByMode(cat.actual, cat.end, cat.daysType, true);
                const totalPeriodDays = calculateDaysByMode(cat.start, cat.end, cat.daysType, false);
                const dailyRate = totalPeriodDays > 0 ? (cat.income / totalPeriodDays) : 0;
                const resultBudget = remainingDays * dailyRate;
                const deficit = resultBudget - cat.saldoTarjeta;

                if (deficit > 0) {
                    totalDeficit += deficit;
                    categoriesWithDeficit.push({ name: cat.name, val: deficit });
                }
            });

            // Actualizar Tarjetas de Estadísticas
            document.getElementById('total-income-stat').innerText = formatPEN(totalIncome);
            document.getElementById('total-card-stat').innerText = formatPEN(totalCard);
            document.getElementById('total-deficit-stat').innerText = formatPEN(totalDeficit);

            const advTitle = document.getElementById('advisor-title');
            const advAdvice = document.getElementById('advisor-advice');

            if (state.categories.length === 0) {
                advTitle.innerText = "No hay columnas de control activas";
                advAdvice.innerText = "Agrega una nueva columna de gasto o haz clic en 'Cargar Datos Originales' para analizar tus finanzas.";
                return;
            }

            if (totalDeficit > 0) {
                advTitle.innerText = "⚠️ Advertencia de Saldos Faltantes";
                let listNames = categoriesWithDeficit.map(c => `<strong>${c.name}</strong> (Faltante: ${formatPEN(c.val)})`).join(', ');
                advAdvice.innerHTML = `Tu saldo disponible no cubre el presupuesto restante. Registras una brecha total de ${formatPEN(totalDeficit)}. Se recomienda inyectar saldo a tus cuentas en: ${listNames}.`;
            } else {
                advTitle.innerText = "🟢 Estado Financiero Saludable";
                advAdvice.innerHTML = `¡Fabuloso! Tu saldo actual en tarjeta cubre con exactitud matemática el consumo diario proyectado para lo que resta del período. Mantén este ritmo de gasto.`;
            }
        }

        // Función para cambiar valores directamente de las celdas
        function updateValue(categoryIndex, key, value) {
            state.categories[categoryIndex][key] = value;
            renderDashboard();
        }

        // Eliminar categorías existentes
        function removeCategory(index) {
            const name = state.categories[index].name;
            state.categories.splice(index, 1);
            renderDashboard();
            showNotification(`Columna "${name}" eliminada.`);
        }

        // Modales interactivos
        function openAddCategoryModal() {
            const modal = document.getElementById('add-category-modal');
            const card = document.getElementById('modal-card');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                card.classList.remove('scale-95');
                card.classList.add('scale-100');
            }, 15);
        }

        function closeAddCategoryModal() {
            const modal = document.getElementById('add-category-modal');
            const card = document.getElementById('modal-card');
            modal.classList.remove('opacity-100');
            card.classList.remove('scale-100');
            card.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // Crear nueva columna desde el Modal
        function saveNewCategory() {
            const nameInput = document.getElementById('new-cat-name');
            const name = nameInput.value.trim().toUpperCase();
            const type = document.getElementById('new-cat-type').value;
            const start = document.getElementById('new-cat-start').value;
            const end = document.getElementById('new-cat-end').value;
            const income = parseFloat(document.getElementById('new-cat-income').value) || 0;
            const saldo = parseFloat(document.getElementById('new-cat-saldo').value) || 0;

            if (!name) {
                showNotification("¡Por favor, asigna un nombre para la categoría!");
                return;
            }

            const colorsList = [
                { color: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40', hColor: 'bg-emerald-500 text-slate-950' },
                { color: 'bg-amber-500/20 text-amber-300 border-amber-500/40', hColor: 'bg-amber-400 text-slate-950' },
                { color: 'bg-orange-500/20 text-orange-400 border-orange-500/40', hColor: 'bg-orange-500 text-slate-950' },
                { color: 'bg-sky-500/20 text-sky-400 border-sky-500/40', hColor: 'bg-sky-500 text-slate-950' },
                { color: 'bg-purple-500/20 text-purple-400 border-purple-500/40', hColor: 'bg-purple-500 text-slate-950' }
            ];
            const chosenColors = colorsList[Math.floor(Math.random() * colorsList.length)];

            state.categories.push({
                id: 'cat_' + Date.now(),
                name: name,
                color: chosenColors.color,
                headerColor: chosenColors.hColor,
                daysType: type,
                start: start,
                actual: '2026-07-11', // Sincronizado con la fecha del sistema
                end: end,
                income: income,
                saldoTarjeta: saldo
            });

            // Limpieza de inputs
            nameInput.value = '';
            document.getElementById('new-cat-income').value = '';
            document.getElementById('new-cat-saldo').value = '';

            closeAddCategoryModal();
            renderDashboard();
            showNotification(`¡Columna "${name}" creada correctamente!`);
        }

        // Restablecer al estado original
        function resetToExcelDefaults() {
            state.categories = JSON.parse(JSON.stringify(DEFAULT_CATEGORIES));
            renderDashboard();
            showNotification("Datos restablecidos al estado original del Excel.");
        }

        // Arranque de la app
        window.onload = function() {
            renderDashboard();
        }
    </script>
</body>
</html>
